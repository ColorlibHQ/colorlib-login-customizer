{
    "name": "colorlib/login-customizer",
    "description": "Customize the WordPress login page directly from the Customizer",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Colorlib",
            "email": "support@colorlib.com",
            "homepage": "https://colorlib.com"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^9.6",
        "wp-coding-standards/wpcs": "^3.3"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "phpcs": "phpcs -p --standard=./phpcs.ruleset.xml .",
        "phpcbf": "phpcbf -p --standard=./phpcs.ruleset.xml .",
        "lint": "phpcs -p --standard=./phpcs.ruleset.xml .",
        "test": "phpunit --colors=always",
        "compat": "phpcs -p --standard=PHPCompatibilityWP --runtime-set testVersion 8.0- --extensions=php --ignore='*/vendor/*,*/node_modules/*,*/tests/*' ."
    }
}
